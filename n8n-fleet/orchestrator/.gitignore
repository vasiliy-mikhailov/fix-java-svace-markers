# Maven build output. Mirrors engine/.gitignore — the repo root has no `target` rule because nothing
# here was a Maven project before the engine.
target/

# The DEFAULT on-disk database, when FSM_DB_PATH is left at its default of ./data/fsm — i.e. every
# `mvn spring-boot:run` from this directory. It is a live H2 store holding 282 markers, their
# evidence and their drafted PR bodies; committing it would put run data and repository contents into
# git history, and it is regenerated by schema.sql on the next start.
data/
*.mv.db
*.trace.db
*.lock.db
