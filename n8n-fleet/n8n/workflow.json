{
  "id": "fjbdispatcher001",
  "name": "fjb-dispatcher",
  "active": false,
  "nodes": [
    {
      "parameters": {
        "rule": { "interval": [ { "field": "minutes", "minutesInterval": 2 } ] }
      },
      "id": "b1a1e000-0000-4000-8000-000000000001",
      "name": "Every 2 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [ 320, 300 ]
    },
    {
      "parameters": {
        "url": "http://dispatch:8080/",
        "options": { "response": { "response": { "responseFormat": "text" } } }
      },
      "id": "b1a1e000-0000-4000-8000-000000000002",
      "name": "Maintain fleet",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [ 560, 300 ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "a1", "name": "dispatch", "value": "={{ $json.data }}", "type": "string" }
          ]
        },
        "options": {}
      },
      "id": "b1a1e000-0000-4000-8000-000000000003",
      "name": "Status",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [ 800, 300 ]
    }
  ],
  "connections": {
    "Every 2 minutes": { "main": [ [ { "node": "Maintain fleet", "type": "main", "index": 0 } ] ] },
    "Maintain fleet": { "main": [ [ { "node": "Status", "type": "main", "index": 0 } ] ] }
  },
  "settings": { "executionOrder": "v1" }
}
