          }
        ]
      ]
    },
    "Repo info": {
      "main": [
        [
          {
            "node": "List tree",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "List tree": {
      "main": [
        [
          {
            "node": "Pick files",
            "type": "main",
