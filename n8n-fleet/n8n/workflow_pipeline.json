          }
        ]
      ]
    },
    "Loop over files": {
      "main": [
        [
          {
            "node": "Aggregate",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Fetch content",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch content": {
      "main": [
        [
          {
            "node": "Build FIND request",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build FIND request": {
      "main": [
        [
          {
            "node": "FIND (vLLM)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "FIND (vLLM)": {
      "main": [
        [
          {
            "node": "Parse FIND",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Parse FIND": {
      "main": [
        [
          {
            "node": "Loop over files",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Aggregate": {
      "main": [
        [
          {
            "node": "Write results",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}