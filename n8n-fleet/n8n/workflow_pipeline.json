{
  "id": "fjbpipeline0001",
  "name": "fjb-pipeline",
  "active": false,
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "run",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "node-01",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        300
      ],
      "webhookId": "fjbrunhook0001"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "c1",
              "name": "repo",
              "value": "={{ $json.body.repo || 'google/gson' }}",
              "type": "string"
            },
            {
              "id": "c2",
              "name": "maxFiles",
              "value": "={{ $json.body.maxFiles || 25 }}",
              "type": "number"
            },
            {
              "id": "c3",
              "name": "proveTop",
              "value": "={{ $json.body.proveTop || 5 }}",
              "type": "number"
            }
          ]
        },
        "options": {}
      },
      "id": "node-02",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "url": "=https://api.github.com/repos/{{ $json.repo }}",
        "options": {},
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "User-Agent",
              "value": "n8n-fjb"
            },
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.GITHUB_TOKEN }}"
            }
          ]
        }
      },
      "id": "node-03",
      "name": "Repo info",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "url": "=https://api.github.com/repos/{{ $('Config').item.json.repo }}/git/trees/{{ $json.default_branch }}?recursive=1",
        "options": {},
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "User-Agent",
              "value": "n8n-fjb"
            },
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.GITHUB_TOKEN }}"
            }
          ]
        }
      },
      "id": "node-04",
      "name": "List tree",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        300
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const cfg = $('Config').first().json;\nconst branch = $('Repo info').first().json.default_branch;\nconst tree = ($input.first().json.tree) || [];\nconst bad = ['/test/', '/tests/', '/generated/'];\nconst picked = tree.filter(t =>\n  t.type === 'blob' &&\n  t.path.includes('/src/main/java/') &&\n  t.path.endsWith('.java') &&\n  !bad.some(b => t.path.toLowerCase().includes(b))\n).slice(0, cfg.maxFiles);\nreturn picked.map(t => ({ json: { repo: cfg.repo, branch, path: t.path } }));"
      },
      "id": "node-05",
      "name": "Pick files",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        300
      ]
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "id": "node-06",
      "name": "Loop over files",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        1100,
        300
      ]
    },
    {
      "parameters": {
        "url": "=https://raw.githubusercontent.com/{{ $json.repo }}/{{ $json.branch }}/{{ $json.path }}",
        "options": {}
      },
      "id": "node-07",
      "name": "Fetch content",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1320,
        300
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const path = $('Loop over files').item.json.path;\nconst repo = $('Config').first().json.repo;\nlet src = ($json.data || '').toString();\nif (src.length > 6000) src = src.slice(0, 6000);\nconst prompt =\n\"You are a careful Java bug finder. Analyze this ONE file for a genuine, user-reachable bug \" +\n\"(correctness / data-corruption / resource-or-credential-leak / API-contract violation). \" +\n\"Ignore style, naming and hypothetical misuse.\\n\" +\n\"Reply with ONLY a JSON object: \" +\n\"{\\\"has_bug\\\": true|false, \\\"line\\\": <int>, \\\"severity\\\": \\\"high|medium|low\\\", \" +\n\"\\\"category\\\": \\\"correctness|data-corruption|resource-leak|contract-violation|npe\\\", \" +\n\"\\\"bug\\\": \\\"<one sentence>\\\", \\\"why\\\": \\\"<how it fails: concrete input -> wrong output>\\\", \" +\n\"\\\"fix\\\": \\\"<the minimal one-line fix>\\\"}\\n\" +\n\"If there is no real bug, reply {\\\"has_bug\\\": false}.\\n\\n\" +\n\"FILE: \" + path + \"\\n```java\\n\" + src + \"\\n```\";\nreturn { repo, path, body: {\n  model: $env.QWEN_MODEL,\n  messages: [{ role: 'user', content: prompt }],\n  temperature: 0.2, max_tokens: 5000,\n  enable_thinking: true, thinking_budget: 1024\n}};"
      },
      "id": "node-08",
      "name": "Build FIND request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.QWEN_BASE_URL }}/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.QWEN_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Connection",
              "value": "close"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body) }}",
        "options": {
          "timeout": 280000
        }
      },
      "id": "node-09",
      "name": "FIND (vLLM)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1760,
        300
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const path = $('Build FIND request').item.json.path;\nconst repo = $('Build FIND request').item.json.repo;\nconst msg = ($json.choices && $json.choices[0] && $json.choices[0].message) || {};\nconst text = msg.content || msg.reasoning_content || '';\nconst a = text.indexOf('{'); const b = text.lastIndexOf('}');\nconst s = (a >= 0 && b > a) ? text.slice(a, b + 1) : null;\nlet j = null;\ntry { j = s ? JSON.parse(s) : null; } catch (e) { j = null; }\nif (!j || !j.has_bug) return { repo, path, has_bug: false };\nreturn { repo, path, has_bug: true, line: j.line, severity: j.severity,\n         category: j.category, bug: j.bug, why: j.why, fix: j.fix };"
      },
      "id": "node-10",
      "name": "Parse FIND",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1980,
        300
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const cfg = $('Config').first().json;\nconst all = $input.all().map(i => i.json);\nconst order = { high: 0, medium: 1, low: 2 };\nconst findings = all.filter(f => f.has_bug)\n  .sort((a, b) => (order[a.severity] ?? 3) - (order[b.severity] ?? 3));\nconst out = { repo: cfg.repo, scanned: all.length, count: findings.length, findings };\nconst fname = cfg.repo.replace('/', '__') + '.json';\nconst b64 = Buffer.from(JSON.stringify(out, null, 2)).toString('base64');\nreturn [{ json: out, binary: { data: { data: b64, mimeType: 'application/json', fileName: fname } } }];"
      },
      "id": "node-11",
      "name": "Aggregate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2200,
        300
      ]
    },
    {
      "parameters": {
        "operation": "write",
        "fileName": "=/results/{{ $('Config').item.json.repo.replace('/', '__') }}.json",
        "dataPropertyName": "data",
        "options": {}
      },
      "id": "node-12",
      "name": "Write results",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [
        2420,
        300
      ]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Config",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Config": {
      "main": [
        [
          {
            "node": "Repo info",
