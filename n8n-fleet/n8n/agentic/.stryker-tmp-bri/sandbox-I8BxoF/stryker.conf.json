{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "tap",
  "mutate": [
    "src/nodes/**/*.js",
    "src/lib/**/*.js"
  ],
  "reporters": [
    "clear-text",
    "json"
  ],
  "coverageAnalysis": "perTest",
  "thresholds": {
    "high": 90,
    "low": 80,
    "break": null
  },
  "tempDirName": ".stryker-tmp",
  "cleanTempDir": true,
  "mutator": {
    "excludedMutations": [
      "StringLiteral"
    ]
  },
  "jsonReporter": {
    "fileName": "reports/mutation.json"
  },
  "tap": {
    "testFiles": [
      "test/**/*.test.js"
    ]
  }
}