{
  "packageManager": "npm",
  "testRunner": "tap",
  "mutate": ["src/lib/exec-verdict.js"],
  "reporters": ["clear-text"],
  "coverageAnalysis": "perTest",
  "thresholds": { "high": 90, "low": 80, "break": null },
  "tempDirName": ".stryker-tmp-ev",
  "ignorePatterns": [".stryker-tmp*", "coverage", "reports"],
  "cleanTempDir": "always",
  "concurrency": 4,
  "mutator": { "excludedMutations": ["StringLiteral"] },
  "tap": {
    "testFiles": [
      "test/exec-verdict.test.js",
      "test/verdict.test.js",
      "test/backfill-verdicts.test.js"
    ]
  }
}
