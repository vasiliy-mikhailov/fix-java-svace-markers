<?xml version="1.0" encoding="UTF-8"?>
<!--
  THE PROVE, AS A DEEP AGENT. See SPEC.md.

  A module of its own, and not part of pipeline/: it shares no code with the old chain on purpose.
  This is the from-scratch expression, so it inherits none of engine's zero-runtime-dependency policy
  and none of orchestrator's Spring.

  langchain4j-deepagents IS NOT ON MAVEN CENTRAL. Build it first:
      git clone https://github.com/udayogra/langchain4j-deepagents && (cd langchain4j-deepagents && mvn -DskipTests install)
  Deploying this needs that artifact in the shared Nexus, because java-runner/settings.xml sets
  mirrorOf=* and an unmirrored artifact is a build that does not run.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>tech.mikhailov.fsm</groupId>
  <artifactId>agent</artifactId>
  <version>0.1.0-SNAPSHOT</version>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <!--
    SIX VULNERABILITIES THIS SHIPS, NONE OF THEM OURS, ALL OF THEM ARRIVING THROUGH LANGCHAIN4J.

    Neither library is a dependency this project declares. Both come in transitively, at whatever
    version langchain4j 1.9.1 happens to pin, and a scan of the published image found six issues at
    CRITICAL or HIGH in exactly those two:

      opennlp-tools 2.5.4   CVE-2026-40682, CVE-2026-42027 (CRITICAL), CVE-2026-42440 — fixed 2.5.9
      jackson 2.20.1        CVE-2026-54512, CVE-2026-54513, GHSA-r7wm-3cxj-wff9      — fixed 2.21.4

    `dependencyManagement` and NOT a direct dependency, because this project does not use either
    library and adding it to `<dependencies>` would say it does. This raises the floor for whoever
    pulls them in and changes nothing else about the build.

    Jackson goes through its BOM so that core, databind and annotations move together — the three
    are version-locked in practice, and pinning `jackson-databind` alone is how a build ends up with
    a databind that its own core cannot serialise for.

    THE COST OF A PIN IS THE CEILING IT ALSO SETS. `dependencyManagement` wins over a transitive
    version in both directions: if a later langchain4j needs something newer, this holds it back and
    the failure is a NoSuchMethodError rather than a resolution error. Raise these with the upgrade
    rather than leaving them to be discovered.

    Found by Sergey Boykov (PR #1), which also carried CRLF handling and an `apt-get upgrade` in the
    runtime stage. The upgrade fixed nothing at CRITICAL or HIGH — the OS layer was already clean at
    those severities — and it makes two builds of one commit differ, so only the part that removes
    the vulnerabilities is taken here.
  -->
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.fasterxml.jackson</groupId>
        <artifactId>jackson-bom</artifactId>
        <version>2.21.5</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.apache.opennlp</groupId>
        <artifactId>opennlp-tools</artifactId>
        <version>2.5.10</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!--
      JUnit, and it runs in the build. Every bug this suite pins was found by deploying to a server
      and reading a trace back; each is a pure function that answers in a millisecond.
    -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.11.4</version>
      <scope>test</scope>
    </dependency>

    <!-- THE CHAIN GRAMMAR, AS A LIBRARY. `ratchet-core` declares no dependencies of its own, so
         this costs nothing transitively and can be adopted a stage at a time. It is not on Maven
         Central: `git clone` it, `git checkout v0.5.0`, `mvn -DskipTests install`.
           THE TAG IS PART OF THE INSTRUCTION: 0.3.0 was never tagged, so following this against a
           fresh checkout installed the tip and the build could not then resolve what this line
           asks for. The Dockerfile pins the commit that tag points at; keep the two in step.
           Only `ratchet-core` —
         `ratchet-llm` reads its endpoint settings from the environment at process start, and this
         program re-reads them per prove so a sweep stays steerable while it runs. -->
    <dependency>
      <groupId>tech.mikhailov.ratchet</groupId>
      <artifactId>ratchet-core</artifactId>
      <version>0.5.0</version>
    </dependency>
    <dependency>
      <groupId>com.deepagents</groupId>
      <artifactId>langchain4j-deepagents</artifactId>
      <version>0.1.0-SNAPSHOT</version>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <version>2.0.16</version>
      <scope>runtime</scope>
    </dependency>
    <!-- The JDK http client, named explicitly: the agent pins HTTP/1.1 on it. -->
    <dependency>
      <groupId>dev.langchain4j</groupId>
      <artifactId>langchain4j-http-client-jdk</artifactId>
      <version>1.9.1</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.14.1</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.6</version>
                <configuration>
                    <!-- THE PROMPT TESTS WRITE FILES, and Prompts reads one directory fixed at class
                         load. Without this they skip on any machine where /results does not exist,
                         which is every machine except the container — three tests that pass by not
                         running. -->
                    <environmentVariables>
                        <PROMPTS>${project.build.directory}/test-prompts</PROMPTS>
                        <TUNING>${project.build.directory}/test-model</TUNING>
                    </environmentVariables>
                </configuration>
      </plugin>
    </plugins>
  </build>
</project>
