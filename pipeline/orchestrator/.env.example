# fsm-orchestrator — the environment the compose service reads.
#
# COPY THIS TO ../deploy/.env, which is where `docker compose` looks: compose reads `.env` from the
# directory holding the compose file, not from the module. It is the SAME file every service in that
# stack reads, so if it already exists, add the missing lines to it rather than replacing it.
# deploy/.env.example is the fuller, deployment-side version of this file.
#
#   cp orchestrator/.env.example deploy/.env       # first time
#
# NOTHING HERE IS BOUND BY application.yml. QWEN_*, GIT_TOKEN and SVACE_* are read straight from the
# process environment by tech.mikhailov.fsm.orch.Secrets, which deliberately does NOT go through
# Spring's Environment — so a credential pasted into a yaml file would not even take effect. Values are
# left EMPTY below on purpose: an example file with a real key in it is how a credential reaches git
# history, and orchestrator/src/test/.../DeploymentTest asserts these lines carry none.

# ---- the model endpoint (required) ---------------------------------------------------------------
# It must resolve FROM INSIDE the container, which is not the same as from your shell; if the model
# lives in another compose stack, put this container on that stack's network
# (deploy/docker-compose.override.yml.example). Unset, every model call fails as
# `undefined/chat/completions` — greppable on purpose — and the process says so in a WARN on the way up.
QWEN_BASE_URL=
QWEN_API_KEY=
QWEN_MODEL=

# ---- the git host (required) ----------------------------------------------------------------------
# Clone/read access to the repositories under analysis. It is handed to git per command through a
# credential helper, so it is never written into any checkout's .git/config and never appears on a
# command line. Unauthenticated against a private repository does NOT fail loudly: it fails as every
# marker in the run being recorded against a file nobody could read.
#
# GIT_TOKEN is the name; GITHUB_TOKEN is still read when it is unset, because every deployed .env
# has one. Set ONE of them.
GIT_TOKEN=
GITHUB_TOKEN=

# Where a bare `owner/name` in an ingest body is cloned from. github.com unless you set this. A marker
# whose `repo` is a full clone URL — https://gitlab.company/grp/proj.git, ssh://git@host/grp/proj.git,
# or host/group/project — names its own host and ignores this, so one backlog can span two servers.
FSM_GIT_HOST=

# Where the PROVE reads a marker's source from. `checkout` (the default) reads it out of the clone the
# prove already makes, which works for any host git can reach. `github` uses the GitHub contents API,
# which needs an owner/name repo and refuses anything else.
FSM_SOURCE_MODE=

# ---- Svace (optional) ----------------------------------------------------------------------------
# With no endpoint, Verdict argues from the code instead of failing. Leave both blank unless you have
# a Svace server whose warning detail you want in the verdict.
SVACE_BASE_URL=
SVACE_TOKEN=

# ---- run control (optional; the defaults are the deployed behaviour) ------------------------------
# false makes this a REST-only orchestrator: nothing claims a marker until you POST. Set it while you
# are debugging one marker, and any time a second prover could be running: two provers share no lock,
# and they patch each other's workspace with nothing anywhere going red.
FSM_PROVE_SCHEDULE=true

# ONE dedup_key to prove on the way up and nothing else. Empty in every normal deployment. Pair it with
# FSM_PROVE_SCHEDULE=false; see orchestrator/README.md, "Prove one marker".
FSM_PROVE_MARKER=

# ---- the five stage prompts (optional; the files at the repo root are the real home) --------------
# PROMPTS ARE NOT SECRETS AND DO NOT BELONG IN THIS FILE. They are source: diffable, reviewable,
# versioned beside the code, and tunable: the feedback store folds recurring complaints back into them,
# and you cannot iterate on a prompt that lives in a secrets file. They live in git, at
#
#     <repo root>/prompts/{reproducer,fixer,fix-skeptic,pr-maker,verdict}.txt
#
# which the compose file mounts read-only at /data/prompts. Edit one there and restart the container.
#
# WHERE THE PROCESS LOOKS. Only if you are not using the standard mount.
FSM_PROMPTS_DIR=/data/prompts
#
# THE FALLBACKS, and they are commented out ON PURPOSE. Resolution is per stage: the file wins, then
# DEFAULT_<STAGE>_PROMPT, then the text compiled into the class — which is what a deployment with no
# prompts directory gets. Set one of these only to override a stage on a host whose repo is not mounted;
# leaving it UNSET is how you keep the built-in, and setting it EMPTY is a start-up failure rather than
# a silently blank prompt.
#
# DEFAULT_REPRODUCER_PROMPT=
# DEFAULT_FIXER_PROMPT=
# DEFAULT_FIX_SKEPTIC_PROMPT=
# DEFAULT_PR_MAKER_PROMPT=
# DEFAULT_VERDICT_PROMPT=

# ---- the feedback store (optional; OFF, and the default is the safety property) -------------------
# ONE JSON LINE PER SETTLED MARKER, appended to <repo root>/feedback/gepa-feedback.jsonl and
# accumulated ACROSS RUNS — the resolved prompts, the raw model replies, the code in and out, and the
# concrete complaints the pipeline already makes about each of them. It is what a prompt-tuning pass
# reads: a prompt cannot be improved from a score, only from seeing the prompt, what it produced and
# why that was wrong.
#
# OFF unless you turn it on, because that completeness is also the cost: full prompts, full replies and
# source excerpts from the repositories under analysis, at gigabytes over a few runs. The file is
# gitignored and its own first line says what it holds. Never commit it or paste it into an issue.
#
# IT NEEDS THE WRITABLE MOUNT. The repository is bound read-only; deploy/docker-compose.yml adds a second
# bind over feedback/ alone, and that directory has to be writable by uid 10002 (the container's user):
#     sudo chown 10002:10002 feedback
# Get it wrong and the process says so with an ERROR on the way up. See orchestrator/README.md,
# "The feedback store".
FSM_FEEDBACK=false
# The FILE, not its directory. Only move it off the mount if you know where it will land.
FSM_FEEDBACK_PATH=/data/feedback/gepa-feedback.jsonl

# ---- build (optional) ----------------------------------------------------------------------------
# A Maven mirror. At RUN time it is where the analysed projects resolve from; as a build argument it is
# where the image's own build resolves from. Needed only where Central is slow or blocked — and a mirror
# that lives on a private Docker network needs the legacy builder, because `docker build` cannot join
# one. See DOCKER.md.
MAVEN_MIRROR_URL=
