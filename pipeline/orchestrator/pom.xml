<?xml version="1.0" encoding="UTF-8"?>
<!--
  orchestrator — what replaces n8n.

  n8n contributed four things and only four: a schedule, a single-flight queue, two Data Tables and a
  run history. All of them are ordinary server concerns, and none of them was worth a second runtime,
  a second container and a workflow JSON that could not be unit-tested. This module takes them over.

  It takes over NOTHING ELSE. Every judgement — the anchoring, the realness score, the verdict routing,
  the infra-vs-verdict state machine — stays in `engine` and is called here as a library, in-process,
  through the same pure functions the engine's own tests pin. That is why `engine` is a compile
  dependency and not a base URL: an HTTP hop between the queue and the judgement would reintroduce
  exactly the seam this module exists to delete, and would make a 500 from a judgement call
  indistinguishable from a marker that could not be judged.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- spring-boot-starter-parent, NOT the pipeline aggregator: the orchestrator wants Boot's
       dependency management and its resource filtering, and `engine` must not be dragged under a
       parent that manages dependencies for it. <relativePath/> empty is required — without it Maven
       would look for the parent at ../pom.xml, find the aggregator, and fail. -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>

  <groupId>tech.mikhailov.fsm</groupId>
  <artifactId>orchestrator</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>jar</packaging>
  <name>fsm-orchestrator</name>
  <description>Schedule, queue and durable marker state for the Svace-marker pipeline.</description>

  <properties>
    <java.version>25</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <!-- Same versions as engine and runner, deliberately: three modules in one reactor disagreeing
         about the measuring tool would mean three numbers that cannot be added up. JUnit itself is
         managed by spring-boot-dependencies here rather than pinned, so the platform the
         pitest-junit5-plugin binds to is the platform the tests actually run on. -->
    <pitest.version>1.25.8</pitest.version>
    <pitest.junit5.version>1.2.3</pitest.junit5.version>
    <jacoco.version>0.8.15</jacoco.version>

    <!-- THE BROWSER SUITE, AND WHY IT IS NOT IN A NORMAL BUILD.
         Every defect this dashboard has ever shipped answered HTTP 200 — a duplicate `const` that made
         app.js a SyntaxError and rendered a blank page, an /api/bug that went missing so 50 proven
         markers read "not proven yet", a /ws that 404s through a path prefix so live push silently
         degrades. None of them is reachable from the server side, so they are tested in a real browser
         (orchestrator/playwright/, tag `ui`).

         A browser is not a Maven dependency. It is a 200 MB binary with a system-library contract, so
         it comes from the official Playwright-for-Java image and NOT from a download at test time —
         which is why these tests must not run on a laptop with no container runtime, and why they are
         excluded here by TAG rather than by an "is a browser installed?" branch inside the test. A test
         that decides for itself whether to run is a test that reports green having done nothing.

         DEFAULT: run everything EXCEPT the `ui` group. `mvn -Pui test`: run the `ui` group and nothing
         else — that is the command the container's entrypoint issues.

         THE EXCLUSION IS ANNOUNCED. TheBrowserSuiteIsNotInThisBuildTest runs in every ordinary build,
         prints one line naming the suite and the command that runs it, and fails if a ui class loses
         its @Tag (which would make it run here, without a browser) or if the image and the runbook it
         names have gone. A suite silently absent from CI is the same failure class as the bugs it
         chases. -->
    <playwright.version>1.49.0</playwright.version>
    <ui.groups/>
    <ui.excluded.groups>ui</ui.excluded.groups>
  </properties>

  <dependencies>
    <!-- ALL judgement logic. Compile scope, in-process, called as pure functions. -->
    <dependency>
      <groupId>tech.mikhailov.fsm</groupId>
      <artifactId>engine</artifactId>
      <!-- ${project.version}, not a property of its own: all three modules are always built in one
           reactor at one version, so a separate <engine.version> could only ever be a second name for
           this and a way to drift from it. -->
      <version>${project.version}</version>
    </dependency>

    <!-- THE PROVER'S HANDS, AS A LIBRARY, and this line is what makes the deployment one container.

         `runner` was a second service because /run_test does not compute an answer — it clones a
         repository and shells out to Maven, twice, over somebody else's code. What that arrangement
         actually cost was an ADDRESS: http://fsm-runner:8090 written in the compose environment, in
         application.yml and compiled into HttpRunnerClient.DEFAULT_BASE_URL, none of them read until a
         marker is proved, so a stale one surfaces hours into a run as a refused connect filed as an
         infrastructure failure. tech.mikhailov.fsm.runner.LocalRunner is the same Prove, Workspace and
         Build behind the same single-flight queue, called directly.

         THE HTTP SHAPE IS NOT DELETED. `fsm.runner.mode=http` still posts to a runner of its own, for a
         deployment that wants the build sandbox behind a container boundary; see ClientConfig. This
         dependency is what gives the DEFAULT its prover, and it drags in nothing — `runner`'s own pom
         has a zero-third-party-dependency policy and its only dependency is `engine`, which is already
         above. -->
    <dependency>
      <groupId>tech.mikhailov.fsm</groupId>
      <artifactId>runner</artifactId>
      <version>${project.version}</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!-- /actuator/health, and the DataSource health contributor that comes with it. The hand-written
         /healthz answers a restart policy in five characters of plain text; this answers the operator
         who needs to know WHICH component is down, and it aggregates the same probe. It is here rather
         than hand-rolled because the previous hand-rolled answer was the constant string "ok", which
         reported healthy through an entire run in which every prove failed on a refused connection.
         Only the health endpoint is exposed; see the `management` block in application.yml. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <!-- The prove is a long-running, restartable, per-item job over 282 markers. That is what Batch
         is for, and its JobRepository lands in the same H2 file as the markers, so "where did this
         run get to" has one answer and not two. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-batch</artifactId>
    </dependency>

    <!-- The dashboard watches a run that takes 6-26 hours. Polling that is either stale or expensive;
         a socket is neither. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-websocket</artifactId>
    </dependency>

    <!-- JdbcTemplate. No JPA: the two tables are wide, flat, and written by upsert from maps the
         engine produced — an entity mapper would add a second definition of the column list that can
         drift from schema.sql without anything noticing. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>

    <!-- Runtime scope, and DECLARED EXACTLY ONCE. Nothing compiles against H2, so a later move to
         Postgres is a URL change — and `runtime` is already on the test classpath, so a second
         test-scoped declaration is not needed. It is also actively dangerous: Maven collapses two
         declarations of the same groupId:artifactId into one and the LAST scope wins, so adding a
         test-scoped copy here silently demotes the driver to test-only. The whole suite still passes
         (it only ever needed the test classpath) and the packaged jar starts with
         `Cannot load driver class: org.h2.Driver` — a failure no unit test can see. -->
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- JobLauncherTestUtils. The prove is a fault-tolerant chunk step whose interesting behaviour is
         the SKIP path, the chunk rollback and the run history it leaves behind; a test that called the
         reader, the processor and the writer itself would exercise none of them, and every past defect
         in this file lived in exactly that gap. Version managed by spring-boot-dependencies, so it
         cannot drift from the spring-batch-core the job actually runs on. -->
    <dependency>
      <groupId>org.springframework.batch</groupId>
      <artifactId>spring-batch-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- PLAYWRIGHT FOR JAVA — the browser side of this module's tests. See the `ui` properties above
         for why the suite does not run in an ordinary build.

         DECLARED UNCONDITIONALLY, NOT INSIDE THE `ui` PROFILE, and that is deliberate. The eight ui
         classes live in src/test/java like every other test and are COMPILED by every build; only
         their EXECUTION is filtered by tag. Moving the dependency into the profile would make them
         compile only under -Pui, which is a suite that rots invisibly — the exact shape of failure
         AGreenRunMustHaveRunEveryTestClassTest exists to catch, one level up. Compiling them always
         means a rename in DashboardService or a change to the page's payload breaks the build here,
         on the developer's machine, rather than in a container nobody runs before a deploy.

         THE COST, STATED: com.microsoft.playwright:driver-bundle is ~200 MB (node plus the driver for
         every platform) and lands in ~/.m2 on the first build. It is never opened unless
         Playwright.create() is called, which only the tagged suite does. It is NOT excluded here and
         re-added under the profile: that would be one more thing that is only correct in a
         configuration nobody exercises locally, in exchange for a download that happens once.

         The BROWSERS are not in this jar and are not downloaded by it — PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD
         and PLAYWRIGHT_BROWSERS_PATH in orchestrator/playwright/Dockerfile point it at the ones the
         image already ships, at a version matched to this one. -->
    <dependency>
      <groupId>com.microsoft.playwright</groupId>
      <artifactId>playwright</artifactId>
      <version>${playwright.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>fsm-orchestrator</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <compilerArgs>
            <!-- Same reason as the engine: the failures in this pipeline are silent by nature. A
                 marker written off with the wrong status does not crash anything. -->
            <arg>-Xlint:all,-serial,-this-escape</arg>
            <!-- Same reason as the engine, where five dangling {@link}s to a class deleted on
                 2026-08-05 went unnoticed because nobody runs javadoc. `reference` only: the other
                 doclint groups would demand @param and @return on every private helper. -->
            <arg>-Xdoclint:reference</arg>
          </compilerArgs>
        </configuration>
      </plugin>

      <!-- RUN ORDER, PINNED. Surefire's default is `filesystem` — the order the operating system
           happens to hand back directory entries for target/test-classes. That is stable enough on one
           machine to look deliberate and is not promised by anything, so the suite's order can change
           under a clean, a different filesystem or a different JDK, and an order-dependent failure
           surfaces as a defect that "only happened once".

           This module has exactly the shared state that makes order matter: every @SpringBootTest here
           runs against ONE named in-memory database, `jdbc:h2:mem:fsm;DB_CLOSE_DELAY=-1` (see the test
           profile in application.yml), so rows one class leaves behind are visible to the next, and
           HealthzWhenTheDatabaseIsDownTest deliberately closes a connection pool. Alphabetical does not
           make any of that safe — it makes it REPRODUCIBLE, which is the difference between a bug that
           can be bisected and one that cannot.

           `alphabetical`, not `random`: this baseline is about a number that means the same thing twice.
           A randomised order is a good way to FIND order dependence and a bad way to report coverage. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <runOrder>alphabetical</runOrder>

          <!-- THE BROWSER SUITE IS FILTERED OUT HERE, BY TAG, AND NOWHERE ELSE.
               `${ui.excluded.groups}` is `ui` by default and empty under -Pui; `${ui.groups}` is the
               mirror image. So an ordinary `mvn test` runs everything except the tagged classes, and
               `mvn -Pui test` runs the tagged classes and nothing else.

               BY TAG AND NOT BY <excludes> ON A PATH, because a path pattern is satisfied by moving a
               file. A tag is on the class, travels with it, and TheBrowserSuiteIsNotInThisBuildTest
               asserts every class under .../orch/ui carries one — so a ui class that loses its tag is
               a red build here rather than a browser test that runs on a laptop with no browser and
               fails as an infrastructure error nobody reads. -->
          <groups>${ui.groups}</groups>
          <excludedGroups>${ui.excluded.groups}</excludedGroups>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>

      <!-- LINE COVERAGE — the other half of MAC (= line coverage x mutation score), measured over
           ALL of src/main/java with NO excludes. That matters more here than in the other two
           modules, because this one is full of things it is tempting to write off as "just Spring":
           @Configuration classes, a WebSocketConfig, a properties record. They are production code,
           they contain decisions, and every one of them stays in the denominator. A class with no
           test lowers this module's number — that is the measurement working, not a defect in it. -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${jacoco.version}</version>
        <executions>
          <execution>
            <id>prepare-agent</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <!-- `verify`, not `test`: the exec file is only complete once surefire's forked JVM has
                 exited. `mvn test jacoco:report` is the short form. -->
            <id>report</id>
            <phase>verify</phase>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <!-- MUTATION TESTING ON A SPRING BOOT MODULE.
           The scope is the whole module and nothing is excluded, exactly as in engine and runner. The
           settings below are what it took to make that scope RUN; none of them removes a class, a
           package or a mutator from the measurement, and that distinction is the whole point. If any
           of it stops working, the fix is to make the run complete — not to shrink what it covers. -->
      <plugin>
        <groupId>org.pitest</groupId>
        <artifactId>pitest-maven</artifactId>
        <version>${pitest.version}</version>
        <dependencies>
          <dependency>
            <groupId>org.pitest</groupId>
            <artifactId>pitest-junit5-plugin</artifactId>
            <version>${pitest.junit5.version}</version>
          </dependency>
        </dependencies>
        <configuration>
          <targetClasses>
            <param>tech.mikhailov.fsm.orch.*</param>
          </targetClasses>
          <targetTests>
            <param>tech.mikhailov.fsm.orch.*</param>
          </targetTests>
          <!-- THE ONE EXCLUSION IN THIS FILE, AND IT REMOVES NO PRODUCTION CODE FROM THE
               MEASUREMENT. `targetClasses` above is untouched: every class in src/main/java is still
               mutated, and the ui suite's kills would count if it could run. What is excluded is a
               set of TESTS — the browser suite — because PIT would launch each of the eight against
               a browser that is not installed in the JVM running the mutation analysis, and every
               mutant would be recorded RUN_ERROR. That is a HOLE in the measurement, not a smaller
               scope: an unrunnable test cannot kill anything and cannot let anything survive, so
               leaving it in would make the score less trustworthy, not more.
               Run `mvn -Pui test` in the container to exercise them; run `mvn pitest:mutationCoverage`
               here to measure the rest. -->
          <excludedTestClasses>
            <param>tech.mikhailov.fsm.orch.ui.*</param>
          </excludedTestClasses>
          <!-- No <excludedClasses>. `tech.mikhailov.fsm.orch.*` is every production class in this
               module; `engine` is a dependency jar and is measured by its own module's run, so it is
               out of scope here without needing to be excluded (PIT only mutates target/classes).
               An exclusion list on this module would be indistinguishable from hiding whichever
               class scored worst. -->

          <!-- Identical mutator set to engine and runner. Nothing is disabled to raise the score. -->
          <mutators>
            <mutator>DEFAULTS</mutator>
            <mutator>REMOVE_CONDITIONALS</mutator>
            <mutator>EXPERIMENTAL_SWITCH</mutator>
          </mutators>

          <!-- WHAT SPRING COSTS, AND HOW IT IS PAID.
               PIT runs mutants in forked "minion" JVMs. A minion is reused across many mutants, so
               Spring's context cache pays for itself after the first test in that minion — but the
               FIRST one boots a full @SpringBootTest context: H2, schema.sql, the Batch JobRepository,
               the web layer. On this machine that is seconds, and PIT's default per-mutant timeout is
               4000ms + 25%. Left alone, every mutant whose test happened to be first in a fresh minion
               is recorded TIMED_OUT — and TIMED_OUT COUNTS AS KILLED, so the default would not have
               produced a slow run, it would have produced a FLATTERING one. 60s is comfortably past a
               cold context on a loaded machine while still catching a genuine infinite loop.

               Note this is exactly the shape of the gaming this baseline exists to undo: a knob that
               looks like performance tuning and is really a score. It is set generously in the
               direction that makes the number WORSE and slower, not better and faster. -->
          <timeoutConstant>60000</timeoutConstant>

          <!-- 4 of 8 cores. Each minion holds its own Spring context and its own in-memory H2, so
               threads cost RAM, not just CPU; 4 keeps headroom so a GC pause in one minion cannot
               push another past the timeout and turn a survivor into a false kill. The tests are
               isolated across minions by construction — the test profile is `jdbc:h2:mem:` per JVM,
               and the two on-disk tests use @TempDir. -->
          <threads>4</threads>

          <!-- Heap for a minion running a full Boot context plus Batch. The default inherits the
               launching JVM's, which is not sized for this and fails as an OOM mid-run — reported as
               a RUN_ERROR, i.e. a hole in the measurement. -->
          <jvmArgs>
            <jvmArg>-Xmx2g</jvmArg>
            <!-- Boot's own test JVM setting: without it, the Batch/Hikari threads keep the minion
                 alive past the mutant and PIT waits out the timeout on a mutant it already judged. -->
            <jvmArg>-Djava.awt.headless=true</jvmArg>
          </jvmArgs>

          <outputFormats>
            <param>HTML</param>
            <param>XML</param>
          </outputFormats>
          <timestampedReports>false</timestampedReports>
          <reportsDirectory>${project.build.directory}/pit-reports</reportsDirectory>

          <!-- No mutationThreshold, matching the other two modules: the score is read, not enforced.
               A break threshold on a module this far from its target only teaches people -DskipTests. -->
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- THE BROWSER SUITE. `mvn -Pui test` runs every @Tag("ui") class under
         tech.mikhailov.fsm.orch.ui and NOTHING ELSE.

         IT IS MEANT TO BE ISSUED INSIDE THE CONTAINER, by orchestrator/playwright/Dockerfile's
         entrypoint. Nothing stops it being issued on a machine with a Playwright browser already
         installed at PLAYWRIGHT_BROWSERS_PATH, and that is a legitimate way to iterate — but it is not
         the supported route, because "which browser build is this" then becomes a per-machine
         question, and a browser one version out from the driver is a failure that reads as a broken
         page. The image pins the two together.

         WHY IT INVERTS THE FILTER RATHER THAN JUST CLEARING IT. `-Pui` runs the browser suite ALONE.
         Running the rest of the module's suite alongside it would put a 6-minute Spring/H2 suite in front of the
         thing the container was started to do, and — worse — would let a green container run be quoted
         as "the whole module passes", which it is not: the ordinary suite is the ordinary build's job
         and is where its failures belong. -->
    <profile>
      <id>ui</id>
      <properties>
        <ui.groups>ui</ui.groups>
        <ui.excluded.groups/>
      </properties>
    </profile>
  </profiles>
</project>
