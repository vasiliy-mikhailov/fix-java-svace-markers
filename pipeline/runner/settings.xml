<?xml version="1.0" encoding="UTF-8"?>
<!--
  The RUN-TIME Maven configuration for fsm-runner: how the repositories under test resolve.

  ITS OWN COPY, NOT ../java-runner/settings.xml, and that is deliberate. The whole point of this service
  is that java-runner can be deleted, and a Dockerfile that reached across into the directory it replaces
  would turn that deletion into an unbuildable image. The two files are identical today; if the mirror
  ever moves, this is the copy fsm-runner reads.

  mirrorOf=* MEANS THIS IS THE ONLY REPOSITORY MAVEN WILL TALK TO. It is not a cache in front of Central:
  with `nexus` unreachable, every Maven build of every target repository fails, and it fails looking like
  a broken project rather than like broken wiring — hundreds of lines about unresolvable artifacts. That
  is why the compose service must be on the `mvn-cache` network and why the orchestrator's
  DeploymentTest pins it there. Nexus is shared host infrastructure and lives on that network as `nexus:8081`.

  This is NOT the mirror used to build this project's own jar. That one is the MAVEN_MIRROR_URL build arg
  in runner/Dockerfile, opt-in and defaulting to Central, because `docker build` does not join a compose
  network and a baked-in `http://nexus:8081` would make the image unbuildable everywhere.
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0">
  <mirrors>
    <mirror>
      <id>nexus</id>
      <mirrorOf>*</mirrorOf>
      <name>Nexus Public Group</name>
      <url>http://nexus:8081/repository/maven-public/</url>
    </mirror>
  </mirrors>
</settings>
