# Copy to .env and fill in. Nothing here has a safe default — the two blocks marked REQUIRED
# are the ones without which nothing works.
#
# The orchestrator names any variable it wanted and did not get, in a WARN on the way up:
#   [env] not set: [QWEN_BASE_URL, ...] — the pipeline will run and fail closed on whatever needs them
# "fail closed" means a marker settles with a downgraded verdict and a GREEN run history, so read that
# line rather than assuming a healthy start means a working one.

# ---- REQUIRED: the model -----------------------------------------------------------------------
# Any OpenAI-compatible /chat/completions endpoint. If it runs in Docker, the orchestrator must share
# a network with it — see the networks block in docker-compose.yml and the paragraph above it.
# NO DEFAULT ON PURPOSE. This must be reachable FROM INSIDE the orchestrator container, which is not
# the same as reachable from your shell. Three shapes, pick yours:
#   model on this machine        http://host.docker.internal:8000   (Docker Desktop)
#                                http://<your-LAN-ip>:8000          (Linux)
#   model in another compose     http://<its-service-name>:8000     AND put the orchestrator on that
#                                stack's network — see networks: in docker-compose.yml
#   hosted                       https://api.example.com/v1
# Check it the way that answers the question, once the stack is up:
#   docker exec fsm curl -s -o /dev/null -w '%{http_code}\n' "$QWEN_BASE_URL"
# Any status (200, 401, 404) means the route exists. Only "refused" or "cannot resolve" is broken.
QWEN_BASE_URL=
QWEN_API_KEY=
QWEN_MODEL=

# ---- REQUIRED: reading the repositories under analysis -----------------------------------------
# Clone/read only. Nothing is ever pushed and no pull request is ever opened. It is handed to git per
# command through a credential helper, so it is never written into any checkout's .git/config.
#
# GIT_TOKEN is the name — this pipeline clones whatever host a marker's `repo` names, which need not
# be GitHub. GITHUB_TOKEN is still read when GIT_TOKEN is unset, so an existing .env keeps working.
# Set ONE of them.
GIT_TOKEN=
GITHUB_TOKEN=

# ---- the git host (optional) -------------------------------------------------------------------
# Where a bare `owner/name` in an ingest body is cloned from. Unset means github.com, which is what
# every runbook and the bundled example send.
#
#   FSM_GIT_HOST=gitlab.company.internal      # then `grp/proj` means that server
#
# A marker whose `repo` is a FULL clone URL — https://gitlab.company/grp/proj.git,
# ssh://git@host/grp/proj.git, or host/group/project — names its own host and ignores this, so one
# backlog can span two servers. A `repo` with a credential IN the URL is refused: git would write it
# verbatim into the checkout's .git/config, where the dashboard's source window serves from.
FSM_GIT_HOST=

# Where the PROVE reads a marker's source from.
#   checkout (default) — out of the clone the prove already makes; works for ANY host git can reach
#   github             — the GitHub contents API; needs an owner/name repo and refuses anything else
FSM_SOURCE_MODE=

# ---- ingesting a report (optional) --------------------------------------------------------------
# A Svace report can be sent IN the request (`csv_text` in the JSON body, or `-F 'csv=@report.csv'`)
# instead of being placed on the /data mount. It is untrusted input, so it is bounded: 32 MiB unless
# you change this. Refused, never truncated — half a report is a backlog silently missing markers.
FSM_INGEST_MAX_CSV_BYTES=
# Where an uploaded report is written while the job reads it. Unset means the container's own temp
# directory, which needs no mount, no bind and no chown.
FSM_INGEST_SPOOL_DIR=
# RE-INGESTING IS SAFE, AND THIS IS THE SWITCH THAT MAKES IT UNSAFE. Leave it false.
#
# false (the default) — an ingest ADDS. Markers already in the backlog keep their status, verdict,
#                       artifact and attempt count; markers the report raises that the backlog does not
#                       hold are queued as new work; nothing is discarded. Re-run it as often as you
#                       like, after every restart, with the same report.
# true                — EVERY ingest first DISCARDS the backlog and every artifact. Only for a
#                       deployment whose backlog is disposable — a nightly scan reloaded from scratch.
#
# To discard once, from a request, without setting this: add "reset": true and "reset_confirm": <the
# number of settled markers>, which the API tells you if you get it wrong.
FSM_INGEST_RESET=false

# ---- storage -----------------------------------------------------------------------------------
# Both of these MUST be mounted volumes, and compose sets them correctly — change them with care.
#
# The H2 store. The application default (./data/fsm) is a container's writable layer, thrown away on
# the next `up -d`: the stack starts, serves, accepts an ingest, runs for hours and then reads zero,
# with nothing red at any point.
FSM_DB_PATH=/state/fsm
# The checkouts and build workspaces. Same argument: unmounted, every `up -d` re-clones every
# repository and loses every target/ the second build of each one depends on.
CACHE=/cache

# ---- what the orchestrator does ----------------------------------------------------------------
# true  = drain the backlog on a timer
# false = REST only; you POST /api/prove when you want work done (the debugging default)
FSM_PROVE_SCHEDULE=false

# ONE dedup_key to prove on the way up, then stop. Empty in every normal deployment — it exists so a
# developer can attach a debugger and step through exactly one marker from a cold start, without the
# scheduler racing them. See orchestrator/README.md, "Prove one marker".
FSM_PROVE_MARKER=

# false SKIPS THE VERDICT ARGUMENT ONLY — the stage still runs and still settles every marker.
# Use it to iterate on the earlier prompts without paying for a verdict call per non-reproducing
# marker. Skipped verdicts are labelled `[skipped]` and are never confused with an empty one.
FSM_PROVE_VERDICT=true

# ---- prompt tuning ------------------------------------------------------------------------------
# Where the five prompts are read from. A file here overrides the compiled-in DEFAULT_ fallback, and
# the startup log says which won for each stage.
FSM_PROMPTS_DIR=/data/prompts

# true records FULL prompts, FULL model replies and source excerpts for every settled marker, plus
# harvested critiques, to FSM_FEEDBACK_PATH. Off by default because the file gets large (~3MB per 282
# markers) and holds repository contents. The directory must be writable by the container's uid
# (10002) or the service says so on startup and records nothing.
FSM_FEEDBACK=false
FSM_FEEDBACK_PATH=/data/feedback/gepa-feedback.jsonl

# ---- optional -----------------------------------------------------------------------------------
# WHICH REPOSITORY MAVEN RESOLVES FROM when it builds the projects under analysis.
#
#   empty (the default) -> Maven Central. Works on a machine with nothing but Docker.
#   a URL               -> that mirror, whatever host it names, e.g.
#                          https://nexus.example.com/repository/maven-public/
#
# It is a RUNTIME setting: it takes effect on `docker compose up -d`, on an image you did not build,
# with no rebuild. Use a PUBLIC hostname — a compose-internal name like `nexus:8081` only resolves
# inside the Docker network that stack is on.
#
# This same variable is ALSO passed as a build argument, where it selects the mirror the image's own
# Maven build uses. That half is build-time and unrelated to the proves. `docker compose build` cannot
# join a custom network, so a mirror that lives on one needs the legacy builder — see DOCKER.md.
MAVEN_MIRROR_URL=

# WHERE THE PROVE RUNS.
#   local (the default) -> in the fsm process. One container, and no address to get wrong.
#   http                -> posted to FSM_RUNNER_URL, which you must then run yourself. Worth it if you
#                          want a container boundary between this pipeline's credentials and the build
#                          scripts of the repositories under analysis.
FSM_RUNNER_MODE=local

# Svace endpoint, if you pull reports rather than committing the CSV.
SVACE_BASE_URL=
SVACE_TOKEN=
