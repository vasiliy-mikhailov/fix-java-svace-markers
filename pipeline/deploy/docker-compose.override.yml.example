# THE DEPLOYMENT HOST'S HALF, and it is NOT committed.
#
#   cp docker-compose.override.yml.example docker-compose.override.yml
#
# Compose merges `docker-compose.override.yml` into `docker-compose.yml` automatically — no -f flags,
# no changed command. Everything in this file is therefore additive to the committed stack.
#
# WHY THIS FILE EXISTS AT ALL. An `external: true` network is one machine's private wiring. Declared in
# the committed docker-compose.yml, on every other machine
#
#     docker compose up -d
#     network mvn-cache declared as external, but could not be found
#
# is the FIRST line of output and nothing starts — a hard blocker for every reader, arriving after a
# build that succeeded. A host's private wiring belongs here, where it costs nobody else anything, and
# the committed file stays runnable on a laptop with nothing but Docker.
#
# A MAVEN MIRROR NEEDS NO ENTRY HERE. It is reached by address, not over a shared bridge:
#
#     MAVEN_MIRROR_URL=https://nexus.example.com/repository/maven-public/
#
# in .env, and that is the whole of it. Add a network for it only if the mirror genuinely has no
# reachable address, and then add it below the same way proxy-net is added.

services:
  fsm:
    networks:
      # The stack's own bridge, which the base file gives every service implicitly. It has to be named
      # here too: listing `networks:` at all REPLACES the implicit default, so omitting it would take
      # this container off the network the engine profile shares with it.
      - default
      # …AND the bridge the model lives on. `QWEN_BASE_URL=http://inference-vllm:8000/v1` is a compose
      # service name belonging to another stack, and it only resolves for a container that is on that
      # stack's network.
      #
      # THE FAILURE THIS PREVENTS IS SILENT, which is why it is worth the paragraph. Off proxy-net the
      # name does not resolve; Fix skeptic, PR maker and Verdict all fail CLOSED and answer with safe
      # defaults; the run history stays green and every marker settles as `needs_review` with
      # skeptic_verdict 'unknown' and a downgraded verdict nobody made. Markers that had previously
      # reached `pr_ready` come back downgraded, and the only evidence is the word "unknown" in a cell.
      #
      # Check it the way that answers the question, once the stack is up:
      #     docker exec fsm curl -s -o /dev/null -w '%{http_code}\n' "$QWEN_BASE_URL"
      # Any status — 200, 401, 404 — means the route exists. Only "refused" or "could not resolve" is
      # broken wiring.
      - proxy-net

  # The debugging engine runs the SAME judgement code and makes the same model calls, so it needs the
  # same route — a stage that silently judges nothing is a debugging tool that lies. Harmless when the
  # profile is not active: Compose does not start a profiled service just because an override mentions
  # it.
  engine:
    networks:
      - default
      - proxy-net

networks:
  proxy-net:
    external: true                     # shared with the model's stack (and with inference-caddy)
